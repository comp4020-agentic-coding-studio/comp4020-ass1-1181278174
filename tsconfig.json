{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2023 because scripts/check-evidence.ts already calls toSorted at runtime
    // and works — the lib was simply narrower than the code it never checked.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "noFallthroughCasesInSwitch": true,
    // Node runs .ts directly (`pnpm spike`, `pnpm check:evidence`), and its ESM
    // resolver needs the real extension on every import. tsc rejects that unless
    // this is on; it is safe here because tsc only ever typechecks (noEmit).
    "allowImportingTsExtensions": true
  },
  // src and scripts were outside this list, so nothing in them was typechecked —
  // the engine was about to land in src/sim unchecked.
  "include": ["*.ts", "spec", "src", "scripts"]
}
