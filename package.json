{
  "name": "comp4020-static-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && oxlint --ignore-path .gitignore && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && vitest run",
    "check:evidence": "node scripts/check-evidence.ts",
    "spike": "node scripts/spike.ts",
    "test": "vitest run",
    "derive": "node scripts/derive.ts",
    "build:field": "node scripts/build-field.ts",
    "spike:graded": "node scripts/spike-graded.ts",
    "spike:stagec": "node scripts/spike-stagec.ts",
    "spike:staged": "node scripts/spike-staged.ts",
    "spike:sequence": "node scripts/spike-sequence.ts",
    "spike:block": "node scripts/spike-block.ts",
    "spike:block-fine": "node scripts/spike-block-fine.ts",
    "spike:raise": "node scripts/spike-raise.ts",
    "shot": "node scripts/shot.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
